# Playwright MCP debug artifacts (console logs, page snapshots, downloaded media)
.playwright-mcp/

# Campaign production binary media — deliberately local-only, see company/CLAUDE.md
company/campaign-assets/

# OS
.DS_Store

# Word/Office lock files
~$*

# R session history
.Rhistory

# pandoc docx style template, regeneratable, not itself a deliverable
custom-reference.docx

# Loose screenshots dropped directly in evidence/ (not in a dated subfolder)
# for me to reference, not meant to be committed themselves
evidence/*.jpg
evidence/*.jpeg
evidence/*.png

# Slide-render exports used only to let review agents "see" a .pptx
# (they can't open one directly) — regeneratable from the real .pptx,
# not a deliverable itself.
evidence/**/*slide-render*.jpg
evidence/2026-08-22-demo-day/*.pdf
